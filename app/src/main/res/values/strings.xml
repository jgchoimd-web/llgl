<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">테라리움</string>
    <string name="wallpaper_description">기울이면 구슬이 구르고 모래가 흐르는 유리 상자. 배경화면에서는 터치를 받지 않습니다.</string>
    <string name="menu_hint">폰이 유리 상자입니다. 기울이면 구슬과 모래, 물이 움직이고, 톡 치거나 끌면 생물이 반응하고, 꾹 누르면 먹이가 떨어지고, 흔들면 지진이 납니다. 어두워지면 반딧불이가 나옵니다. 두 손가락으로 톡 치면 이 메뉴가 열립니다.</string>
    <string name="menu_sound">소리</string>
    <string name="menu_haptics">진동</string>
    <string name="menu_wallpaper_sound">배경화면에서도 소리</string>
    <string name="menu_wallpaper_haptics">배경화면에서도 진동</string>
    <string name="menu_wallpaper">배경화면으로 설정</string>
    <string name="menu_wallpaper_unavailable">이 기기에서는 라이브 배경화면을 고를 수 없습니다.</string>
    <string name="menu_reset">새 테라리움</string>
    <string name="menu_close">닫기</string>
</resources>
